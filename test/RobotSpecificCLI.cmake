set(override "${root}/Overrides/robots/MyRobot/config/controller.ini")
file(WRITE "${default}" "default")
file(WRITE "${override}" "override")
foreach(name ROS_PACKAGE_PATH GAZEBO_MODEL_PATH SDF_PATH IGN_GAZEBO_RESOURCE_PATH
             GZ_SIM_RESOURCE_PATH RRU_ADDITIONAL_PATHS AMENT_PREFIX_PATH
             CONDA_PREFIX VIRTUAL_ENV YARP_ROBOT_NAME)
    unset(ENV{${name}})
endforeach()
set(ENV{ACTIVE_ROBOT_NAME} "MyRobot")
set(flags --exclude-active-prefix --package-dir "${root}")

function(check_cli expected_status expected_output)
    execute_process(COMMAND "${TOOL}" ${flags} ${ARGN}
                    WORKING_DIRECTORY "${cwd}"
                    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL expected_status)
        message(FATAL_ERROR "CLI ${ARGN}: status ${status}, expected ${expected_status}: ${error}")
    endif()
    if(expected_status EQUAL 0)
        file(TO_CMAKE_PATH "${output}" output)
        if(NOT output STREQUAL expected_output)
            message(FATAL_ERROR "CLI ${ARGN}: output '${output}', expected '${expected_output}'")
        endif()
    elseif(error STREQUAL "")
        message(FATAL_ERROR "CLI ${ARGN}: missing error message")
    endif()
endfunction()

check_cli(1 "" config/controller.ini)
check_cli(0 "${override}" robot://config/controller.ini)
check_cli(0 "${default}" package://ControlLib/config/controller.ini)
check_cli(0 "${default}" model://ControlLib/config/controller.ini)
check_cli(0 "${default}" "${default}")
check_cli(0 "${default}" "file:///${default}")
file(REMOVE "${override}")
check_cli(0 "${default}" --default-package-name ControlLib robot://config/controller.ini)
check_cli(1 "" config/controller.ini)
file(WRITE "${cwd}/config/controller.ini" "local")
